<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Las demás apps Pro, para pasarles el Código Pro -->
    <queries>
        <package android:name="com.fserrano.promaps" />
        <package android:name="es.proradio.app" />
        <package android:name="es.proinicio.app" />
        <package android:name="es.progaraje.app" />
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="Pro OBD"
        android:theme="@style/ProObdTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Código Pro: recibe el código de vinculación de las demás apps Pro -->
        <receiver
            android:name=".SyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="es.pro.SYNC_CODE" />
                <action android:name="es.pro.SYNC_ASK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
